// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StoreInventoryDemandStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum StoreInventoryDemandResponseStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum StoreInventoryAssignmentStatus {
  ASSIGNED
  RETURNED
  LOST
  DAMAGED
}

enum StoreInventoryAssignmentTargetType {
  GUARD
  EMPLOYEE
  CLIENT
}

enum StoreInventoryMovementType {
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  ASSIGNMENT_OUT
  ASSIGNMENT_RETURN
  DEMAND_OUT
  DEMAND_IN
}

enum StoreInventoryAdjustmentType {
  INCREASE
  DECREASE
  SET
}

enum StoreInventoryPurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

// ============================================
// AUTHENTICATION & AUTHORIZATION
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  contactNumber String?
  photoUrl      String?
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  roleId           String
  role             Role            @relation(fields: [roleId], references: [id])
  regionId         String?
  region           Region?         @relation(fields: [regionId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])

  permissions                       UserPermission[]
  statusHistory                     UserStatusHistory[]
  auditLogs                         AuditLog[]
  ticketsCreated                    Ticket[]                       @relation("TicketSender")
  ticketsAssigned                   Ticket[]                       @relation("TicketAssignee")
  ticketComments                    TicketComment[]
  managerAssignments                ManagerSupervisorAssignment[]  @relation("ManagerAssignments")
  supervisorAssignments             ManagerSupervisorAssignment[]  @relation("SupervisorAssignments")
  clientAssignments                 ClientSupervisorAssignment[]
  guardAssignments                  GuardSupervisorAssignment[]
  clientInsurancesCreated           ClientInsurance[]              @relation("ClientInsuranceCreatedBy")
  guardInsurancesCreated            GuardInsurance[]               @relation("GuardInsuranceCreatedBy")
  guardCoursesCreated               GuardCourse[]                  @relation("GuardCourseCreatedBy")
  requisitionsRequested             Requisition[]                  @relation("RequisitionRequester")
  requisitionsApproved              Requisition[]                  @relation("RequisitionApprover")
  storeInventoryPurchasesCreated    StoreInventoryPurchase[]       @relation("StoreInventoryPurchaseCreatedBy")
  storeInventoryPurchasesApproved   StoreInventoryPurchase[]       @relation("StoreInventoryPurchaseApprovedBy")
  storeInventoryAdjustmentsCreated  StoreInventoryAdjustment[]     @relation("StoreInventoryAdjustmentCreatedBy")
  storeInventoryDemandsRequested    StoreInventoryDemand[]         @relation("StoreInventoryDemandRequestedBy")
  storeInventoryDemandsApproved     StoreInventoryDemand[]         @relation("StoreInventoryDemandApprovedBy")
  storeInventoryDemandResponses     StoreInventoryDemandResponse[] @relation("StoreInventoryDemandResponseResponder")
  storeInventoryAssignmentsReceived StoreInventoryAssignment[]     @relation("StoreInventoryAssignmentAssignee")
  storeInventoryAssignmentsIssued   StoreInventoryAssignment[]     @relation("StoreInventoryAssignmentIssuer")
  storeInventoryAssignmentsReturned StoreInventoryAssignment[]     @relation("StoreInventoryAssignmentReturner")
  storeInventoryMovementsPerformed  StoreInventoryMovement[]       @relation("StoreInventoryMovementPerformedBy")

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  scopeType   RoleScopeType @default(REGIONAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

enum RoleScopeType {
  GLOBAL
  REGIONAL
}

model RolePermission {
  id             String   @id @default(cuid())
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module         String
  canCreate      Boolean  @default(false)
  canView        Boolean  @default(false)
  canUpdate      Boolean  @default(false)
  canDelete      Boolean  @default(false)
  canRequisition Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([roleId, module])
  @@index([roleId])
}

model UserPermission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module         String // GUARDS, PAYROLL, CLIENTS, etc.
  canCreate      Boolean  @default(false)
  canView        Boolean  @default(false)
  canUpdate      Boolean  @default(false)
  canDelete      Boolean  @default(false)
  canRequisition Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

model UserStatusHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  reason    String?
  changedAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// ORGANIZATIONAL STRUCTURE
// ============================================

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regionalOffices RegionalOffice[]
  users           User[]
  guards          Guard[]
  clients         Client[]
  deploymentRates DeploymentRate[]
}

model RegionalOffice {
  id         String   @id @default(cuid())
  name       String
  seriesCode String   @unique // e.g., 'L' for Lahore
  officeHead String?
  phone      String?
  mobile     String?
  fax        String?
  address    String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  users                        User[]
  guards                       Guard[]
  deployments                  Deployment[]
  inventory                    InventoryItem[]
  inventoryDemands             InventoryDemand[]
  storesV2                     Store[]
  managerSupervisorAssignments ManagerSupervisorAssignment[]
  clients                      Client[]

  // Reserve % override: null = use global default 30%; client override takes precedence
  reservePct Float?

  @@index([regionId])
}

// ============================================
// GUARDS MODULE
// ============================================

model Guard {
  id                       String    @id @default(cuid())
  parwestId                String    @unique
  name                     String
  cnic                     String    @unique
  phone                    String?
  email                    String?
  dateOfBirth              DateTime?
  age                      Int?
  fatherName               String?
  religion                 String?
  maritalStatus            String?
  education                String?
  addressPermanent         String?
  addressCurrent           String?
  emergencyContact         String?
  status                   String    @default("PENDING") // LEGACY shadow, kept in sync via src/lib/guards/lifecycle.ts. Derived from lifecycleStatus + active deployments. Values: PENDING | ACTIVE | PRESENT | DEFAULT | INACTIVE | TERMINATED
  lifecycleStatus          String    @default("PENDING") // Source of truth: PENDING | ACTIVE | INACTIVE | TERMINATED
  terminationReason        String? // RESIGNED | FIRED | ABSCONDED | DECEASED | OTHER (required when lifecycleStatus=TERMINATED)
  lifecycleStatusUpdatedAt DateTime?
  isExService              Boolean   @default(false)
  exServiceRank            String?
  exServiceRegiment        String?
  bankName                 String?
  bankAccountNumber        String?
  bankAccountType          String?
  bankIban                 String?
  bankBranchCode           String?
  bankAccountsJson         String? // JSON array of GuardBankAccount objects
  joiningDate              DateTime?
  motherName               String?
  nationality              String?
  nextOfKin                String?
  profileIntroducer        String?
  additionalContactNumbers String?
  nearestRelativesJson     String? // JSON array of NearestRelative objects
  photoUrl                 String? // base64 data URL or external image URL

  // General info extras
  sect           String?
  cast           String?
  bloodGroup     String?
  policeStation  String?
  cnicIssueDate  DateTime?
  cnicExpiryDate DateTime?
  salary         Float?
  designation    String?
  joiningAge     Int?
  enrolledBy     String?

  // Previous employment details
  exServiceType           String? // ARMY, POLICE, RANGERS, MUJAHID, OTHER, CIVILIAN
  exServiceRegistrationNo String?
  exServiceUnit           String?
  exServicePeriod         String?
  exServiceYears          Int?
  exServiceMonths         Int?
  exServiceOtherLabel     String?
  dateOfEnrollment        DateTime?
  dateOfDischarge         DateTime?
  exServiceRemarks        String?

  // Address contacts
  currentAddressContact   String?
  permanentAddressContact String?

  // Education extras
  passingYear        String?
  educationInstitute String?

  // Introducer
  introducerName    String?
  introducerCnic    String?
  introducerAddress String?
  introducerContact String?

  // Physical details
  height             String?
  weight             String?
  eyeColor           String?
  hairColor          String?
  disability         String?
  identificationMark String?

  // Family members
  familyMembersJson String? // JSON array of family member objects

  // Previous employment (multiple entries)
  previousEmploymentsJson String? // JSON array of PreviousEmployment objects

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])
  regionId         String?
  region           Region?         @relation(fields: [regionId], references: [id])

  prerequisites             GuardPrerequisite[]
  pledgedDocumentRecords    GuardPledgedDocumentRecord[]
  deployments               Deployment[]
  payrolls                  Payroll[]
  loans                     Loan[]
  specialDuties             PayrollSpecialDuty[]
  salarySlips               PayrollSalarySlip[]
  attendances               Attendance[]
  inventoryAssignments      InventoryAssignment[]
  storeInventoryAssignments StoreInventoryAssignment[]   @relation("StoreInventoryAssignmentGuardAssignee")
  residenceAssignments      ResidenceAssignment[]
  trainings                 Training[]
  supervisorAssignments     GuardSupervisorAssignment[]
  ageApproval               GuardAgeApproval?
  guardInsurances           GuardInsurance[]
  guardCourses              GuardCourse[]
  reserveLedger             PayrollReserveLedger[]

  // Age approval flags
  ageApprovalRequired Boolean @default(false)
  ageApprovalStatus   String? // PENDING | APPROVED | REJECTED

  @@index([parwestId])
  @@index([cnic])
  @@index([status])
  @@index([lifecycleStatus])
}

// Singleton config for guard age limits
model GuardAgeConfig {
  id     String @id @default(cuid())
  minAge Int    @default(18)
  maxAge Int    @default(45)
}

// Approval request when a guard is over/underage
model GuardAgeApproval {
  id          String    @id @default(cuid())
  guardId     String    @unique
  guard       Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  guardAge    Int
  reason      String // OVERAGE | UNDERAGE
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy String?
  reviewedBy  String?
  reviewedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model BlacklistedCnic {
  id              String   @id @default(cuid())
  cnic            String   @unique
  reason          String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cnic])
}

// Guard service history — keyed by CNIC so it survives re-registrations
// across different guard IDs / regions / parwestIds
model GuardServiceHistory {
  id            String   @id @default(cuid())
  cnic          String // FK-less: guard may be deleted/re-created
  guardId       String? // null when guard no longer exists
  parwestId     String? // snapshot at time of event
  guardName     String? // snapshot at time of event
  event         String // ENROLLED | STATUS_CHANGED | BLACKLISTED | UNBLACKLISTED | REACTIVATED | DEPLOYMENT_STARTED | DEPLOYMENT_ENDED
  fromStatus    String? // previous guard status
  toStatus      String? // new guard status
  description   String?
  changedByName String?
  regionName    String? // snapshot at time of event
  officeName    String? // snapshot at time of event
  createdAt     DateTime @default(now())

  @@index([cnic])
  @@index([guardId])
  @@index([createdAt])
}

// Dedicated per-guard status change log (keyed by guardId)
model GuardStatusHistory {
  id            String   @id @default(cuid())
  guardId       String
  cnic          String? // snapshot for cross-registration tracing
  parwestId     String? // snapshot at time of change
  guardName     String? // snapshot at time of change
  fromStatus    String? // previous status (null on first enrollment)
  toStatus      String // new status
  reason        String? // reason provided by the user
  changedByName String? // name of user who triggered the change
  changedByType String? // MANUAL | SYSTEM | BLACKLIST | ENROLLMENT
  regionName    String? // snapshot
  officeName    String? // snapshot
  createdAt     DateTime @default(now())

  @@index([guardId])
  @@index([cnic])
  @@index([createdAt])
}

model DeploymentRate {
  id            String   @id @default(cuid())
  regionId      String?
  region        Region?  @relation(fields: [regionId], references: [id])
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  deployAs      String?
  guardType     String?
  shiftType     String? // DAY, NIGHT, BOTH
  salary        Float?
  overtime      Float?
  extraHours    Float?
  postAllowance Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([regionId])
  @@index([clientId])
  @@index([branchId])
}

model GuardDocumentType {
  id                String   @id @default(cuid())
  name              String   @unique
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  docCategory       String   @default("VERIFICATION") // VERIFICATION | ATTACHMENT
  isSystemGenerated Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GuardDeploymentInventoryRule {
  id                   String   @id @default(cuid())
  ruleKey              String   @unique @default("default")
  isActive             Boolean  @default(false)
  minimumAssignedItems Int      @default(1)
  allowedCategoryIds   Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model GuardPrerequisite {
  id                 String    @id @default(cuid())
  guardId            String
  guard              Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  docTypeName        String // matches GuardDocumentType.name
  status             String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationStatus String? // REQUEST_SUBMITTED, REQUEST_NOT_SUBMITTED, VERIFIED, NON_VERIFIED, LETTER_ISSUED, LETTER_NOT_ISSUED, FEEDBACK_RECEIVED, FEEDBACK_PENDING
  attachmentData     String? // base64 encoded file
  attachmentName     String? // original file name
  documentUrl        String?
  uploadedBy         String? // who uploaded the current attachment
  uploadedAt         DateTime? // when the current attachment was uploaded
  verifiedAt         DateTime?
  verifiedBy         String? // who set status to VERIFIED
  editedBy           String? // who last edited this record
  editedAt           DateTime? // when it was last edited
  expiryDate         DateTime?
  comments           String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  history GuardPrerequisiteHistory[]

  @@unique([guardId, docTypeName])
  @@index([guardId])
  @@index([docTypeName])
}

model GuardPrerequisiteHistory {
  id             String            @id @default(cuid())
  prereqId       String
  prereq         GuardPrerequisite @relation(fields: [prereqId], references: [id], onDelete: Cascade)
  attachmentData String? // base64 of archived file
  attachmentName String?
  documentUrl    String?
  uploadedBy     String?
  uploadedAt     DateTime          @default(now())

  @@index([prereqId])
}

model Deployment {
  id               String         @id @default(cuid())
  guardId          String
  guard            Guard          @relation(fields: [guardId], references: [id])
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id])
  regionalOfficeId String
  regionalOffice   RegionalOffice @relation(fields: [regionalOfficeId], references: [id])
  designation      String
  deploymentDate   DateTime
  shiftType        String // DAY, NIGHT, BOTH
  rate             Float?
  status           String         @default("ACTIVE") // ACTIVE, INACTIVE
  notes            String?

  // Extended fields from documentation
  guardType        String? // Security Guard, Supervisor, etc.
  salary           Float?
  overtime         Float?
  extraHours       Float?
  postAllowance    Float?
  dayShiftStart    String? // Time format: HH:MM
  dayShiftEnd      String?
  nightShiftStart  String?
  nightShiftEnd    String?
  deploymentType   String? @default("REGULAR") // REGULAR, OVERTIME
  deploymentNature String? @default("PERMANENT") // PERMANENT, TEMPORARY
  isExtraGuard     Boolean @default(false)
  comment          String?

  // End deployment tracking
  endDate   DateTime?
  endReason String?

  // Audit: who performed the action
  deployedByName String? // name of user who created this deployment
  revokedByName  String? // name of user who revoked/ended this deployment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardId])
  @@index([clientId])
  @@index([status])
}

model Attendance {
  id        String   @id @default(cuid())
  guardId   String
  guard     Guard    @relation(fields: [guardId], references: [id])
  date      DateTime
  status    String // PRESENT, ABSENT, LEAVE
  shiftType String? // DAY, NIGHT, BOTH

  // Attendance type for calendar coloring
  attendanceType String? @default("PRESENT") // PRESENT, DOUBLE_DUTY_DAY, DOUBLE_DUTY_NIGHT, EXTRA_DUTY

  // Deployment link — which deployment auto-generated this record
  deploymentId String?
  clientId     String? // denormalized for quick display
  clientName   String? // denormalized client name

  // Hours tracking
  hoursWorked   Float?
  overtimeHours Float?

  // Audit
  isAutoGenerated Boolean @default(false)
  markedBy        String? // userId who manually marked

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guardId, date])
  @@index([guardId])
  @@index([date])
  @@index([deploymentId])
  @@index([clientId])
}

model ResidenceAssignment {
  id             String     @id @default(cuid())
  guardId        String
  guard          Guard      @relation(fields: [guardId], references: [id])
  residenceId    String?
  residence      Residence? @relation(fields: [residenceId], references: [id])
  location       String
  status         String     @default("ACTIVE") // ACTIVE | VACATED
  assignedAt     DateTime   @default(now())
  assignedByName String?
  vacatedAt      DateTime?
  vacatedByName  String?
  vacatedReason  String?
  notes          String?

  @@index([guardId])
  @@index([residenceId])
  @@index([status])
}

model Residence {
  id                 String   @id @default(cuid())
  address            String
  ownerName          String?
  ownerPhone         String?
  supervisor         String?
  capacity           Int?
  occupied           Int?
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE
  rentPayable        Float?
  utilityBills       String? // INCLUDED, EXCLUDED, SHARED
  paymentMethod      String? // CASH, BANK_TRANSFER
  referredBy         String?
  state              String?
  city               String?
  remarks            String?
  contractAttachment String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignments ResidenceAssignment[]

  @@index([status])
}

model Training {
  id           String   @id @default(cuid())
  guardId      String
  guard        Guard    @relation(fields: [guardId], references: [id])
  trainingType String
  completedAt  DateTime
  instructor   String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([guardId])
}

// ============================================
// CLIENTS MODULE
// ============================================

model ClientType {
  id        String   @id @default(cuid())
  name      String   @unique // stored value e.g. "BANK"
  label     String // display label e.g. "Bank"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                  String   @id @default(cuid())
  name                String
  email               String?
  type                String // BANK, MANUFACTURER, etc.
  enrollmentDate      DateTime @default(now())
  isBranchless        Boolean  @default(false)
  headOfficeAddress   String?
  city                String?
  status              String   @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED
  logoUrl             String?
  ntn                 String? // National Tax Number
  strn                String? // Sales Tax Registration
  contractUrl         String?
  contractAttachments Json? // Array of { name: string; dataUrl: string }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Contact
  contactPerson            String?
  contactPersonDesignation String?
  phone                    String? // primary contact number
  contactNumbers           Json? // array of all contact numbers
  postalCode               String?

  // Introducer / Referral
  introducerName          String?
  introducerContactNumber String?
  introducerAddress       String?
  introducerCnic          String?

  // Operational territory
  operationalProvinces String?

  // Assigned users (stored as plain IDs — resolved at query time)
  assignedManagerId String?

  // GPS coordinates (used for branchless clients)
  latitude  Float?
  longitude Float?

  // Guard capacities (branchless clients or per-client defaults)
  dayGuardCapacity        Int?
  nightGuardCapacity      Int?
  daySupervisorCapacity   Int?
  nightSupervisorCapacity Int?
  cpoCapacity             Int?

  // Contract details
  contractStart            DateTime?
  contractEnd              DateTime?
  contractRateStart        DateTime?
  contractRateEnd          DateTime?
  contractGuardDesignation String?
  contractAdditionalGuards Int?
  contractGuardExService   String?
  contractPrice            Float?

  // Contract — day guard specifics
  contractDayGuardDesignation   String?
  contractDayGuardExService     String?
  // Contract — night guard specifics
  contractNightGuardDesignation String?
  contractNightGuardExService   String?
  // Contract — additional guard counts (day/night split)
  contractAdditionalDayGuards   Int?
  contractAdditionalNightGuards Int?

  regionId         String?
  region           Region?         @relation(fields: [regionId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])

  branches                  Branch[]
  deployments               Deployment[]
  pricingConfigs            PricingConfig[]
  inventoryAssignments      InventoryAssignment[]
  storeInventoryAssignments StoreInventoryAssignment[]   @relation("StoreInventoryAssignmentClientAssignee")
  invoices                  Invoice[]
  deploymentRates           DeploymentRate[]
  supervisorAssignments     ClientSupervisorAssignment[]
  contracts                 ClientContract[]
  insurances                ClientInsurance[]
  payrollSpecialDuties      PayrollSpecialDuty[]
  advancePayments           ClientAdvancePayment[]

  // Reserve % override: null = use regional or global default 30%
  reservePct Float?

  @@index([name])
  @@index([status])
}

model Branch {
  id                       String  @id @default(cuid())
  clientId                 String
  client                   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                     String
  code                     String?
  address                  String?
  city                     String?
  province                 String?
  type                     String? // CONVENTIONAL, ISLAMIC, etc.
  isHeadOffice             Boolean @default(false)
  contactPerson            String?
  contactPersonDesignation String?
  contactPhone             String?
  contactEmail             String?
  contractUrl              String?
  contractAttachments      Json? // Array of { name: string; dataUrl: string }

  // Contract details
  contractStart                 DateTime?
  contractEnd                   DateTime?
  contractRateStart             DateTime?
  contractRateEnd               DateTime?
  contractGuardDesignation      String?
  contractAdditionalGuards      Int?
  contractGuardExService        String?
  contractPrice                 Float?
  contractDayGuardDesignation   String?
  contractDayGuardExService     String?
  contractNightGuardDesignation String?
  contractNightGuardExService   String?
  contractAdditionalDayGuards   Int?
  contractAdditionalNightGuards Int?

  // Assignment
  assignedManagerId String?
  regionalOfficeId  String?

  // Location coordinates
  latitude  Float?
  longitude Float?

  // Guard / staff capacity requirements
  dayGuardCapacity          Int?
  nightGuardCapacity        Int?
  daySupervisorCapacity     Int?
  nightSupervisorCapacity   Int?
  cpoCapacity               Int?
  dayCpoCapacity            Int?
  nightCpoCapacity          Int?
  daySoCapacity             Int?
  nightSoCapacity           Int?
  dayAsoCapacity            Int?
  nightAsoCapacity          Int?
  dayLsoCapacity            Int?
  nightLsoCapacity          Int?
  dayCctvCapacity           Int?
  nightCctvCapacity         Int?
  dayReceptionistCapacity   Int?
  nightReceptionistCapacity Int?

  // Branch metadata
  enrollmentDate DateTime?
  isLockerBranch Boolean   @default(false)

  // Extended contact person info
  contactPersonCnic  String?
  contactPersonPhone String?

  // Branch manager info
  branchManagerName    String?
  branchManagerContact String?
  branchManagerEmail   String?

  // Operations manager (separate from assignedManagerId)
  operationsManagerId      String?
  operationsManagerContact String?

  // Supervisor contact
  supervisorContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deployments           Deployment[]
  deploymentRates       DeploymentRate[]
  supervisorAssignments ClientSupervisorAssignment[]
  contracts             ClientContract[]
  payrollSpecialDuties  PayrollSpecialDuty[]
  invoices              Invoice[]
  advancePayments       ClientAdvancePayment[]

  @@index([clientId])
}

model ClientContract {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branchId  String? // null = client-level; set = branch-specific contract
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  type      String    @default("GENERAL") // GENERAL, SPECIAL, etc.
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rates ClientContractRate[]

  @@index([clientId])
  @@index([branchId])
}

model ClientAdvancePayment {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  amount        Float
  appliedAmount Float    @default(0)
  paymentDate   DateTime @default(now())
  method        String? // CASH | BANK | MOBILE | OTHER
  reference     String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications InvoiceAdvanceApplication[]

  @@index([clientId])
  @@index([branchId])
}

model InvoiceAdvanceApplication {
  id        String               @id @default(cuid())
  invoiceId String
  invoice   Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  advanceId String
  advance   ClientAdvancePayment @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime             @default(now())

  @@index([invoiceId])
  @@index([advanceId])
}

model ClientContractRate {
  id            String         @id @default(cuid())
  contractId    String
  contract      ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  province      String?
  city          String?
  guardType     String // GUARD, SUPERVISOR, CPO, etc.
  exService     String? // ARMY, POLICE, RANGERS, MUJAHID, OTHER, CIVILIAN
  rate          Float
  extraHourRate Float?
  isCurrentRate Boolean        @default(false)
  rateStartDate DateTime?
  rateEndDate   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([contractId])
}

model PricingConfig {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  guardType String
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  ADVANCE_PAID
  PARTIAL_PAID
  PAID
  UNPAID
  OVERDUE
  VOID
}

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  invoiceNumber String        @unique
  month         DateTime
  amount        Float
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branchId            String?
  branch              Branch?                     @relation(fields: [branchId], references: [id])
  subtotal            Float                       @default(0)
  taxRate             Float?
  taxAmount           Float                       @default(0)
  paidAmount          Float                       @default(0)
  notes               String?
  voidedAt            DateTime?
  voidReason          String?
  lineItems           InvoiceLineItem[]
  advanceApplications InvoiceAdvanceApplication[]

  @@unique([clientId, branchId, month], map: "Invoice_client_branch_month_key")
  @@index([clientId])
  @@index([status])
  @@index([branchId])
}

// ============================================
// PAYROLL MODULE
// ============================================

model Payroll {
  id                 String    @id @default(cuid())
  guardId            String
  guard              Guard     @relation(fields: [guardId], references: [id])
  month              DateTime
  year               Int
  deploymentDays     Int       @default(0)
  baseSalary         Float     @default(0)
  extraHours         Float     @default(0)
  extraHoursAmount   Float     @default(0)
  specialDutyHours   Float     @default(0)
  specialDutyAmount  Float     @default(0)
  loans              Float     @default(0)
  otherDeductions    Float     @default(0)
  trainingSchoolFees Float     @default(0)
  cwf                Float     @default(0) // Contribution Welfare Fund
  eobi               Float     @default(0)
  essi               Float     @default(0)
  netSalary          Float     @default(0)
  paymentStatus      String    @default("PENDING") // PENDING, PAID, UNPAID
  paymentMethod      String? // BANK, CASH, MOBILE
  paymentRemarks     String?
  paymentUpdatedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // New: separated overtime/extras tracking
  overtimeHours  Float @default(0)
  overtimeAmount Float @default(0)
  // NOTE: extraHours / extraHoursAmount above are retained. In the new model they
  // represent manually-entered extra hours (separate from per-deployment overtime).
  // Wave 2: trainingSchoolFees, cwf, eobi, essi will be deprecated in favor of
  // PayrollDeductionEntry. For now they coexist.

  // New: reserve tracking
  reservePct       Float @default(0.30)
  reserveAmount    Float @default(0)
  netBeforeReserve Float @default(0)

  // New: state machine fields (paymentStatus retained for backward compat)
  // state values: DRAFT | CALCULATED | REGIONAL_LOCKED | GLOBAL_FINALIZED | PAID | HOLD | EMERGENCY_RELEASED
  state                  String    @default("DRAFT")
  holdReason             String?
  holdSetAt              DateTime?
  holdSetById            String?
  regionalLockedAt       DateTime?
  regionalLockedById     String?
  globalFinalizedAt      DateTime?
  globalFinalizedById    String?
  emergencyReleasedAt    DateTime?
  emergencyReleasedById  String?
  emergencyReleaseReason String?

  // New: denormalized scope for fast region-wide locking
  regionId         String?
  regionalOfficeId String?

  // New: relations
  deductionEntries PayrollDeductionEntry[]
  reserveLedger    PayrollReserveLedger[]

  @@unique([guardId, month, year])
  @@index([guardId])
  @@index([month])
  @@index([paymentStatus])
  @@index([state])
  @@index([regionId])
  @@index([regionalOfficeId])
}

model PayrollHoliday {
  id               String    @id @default(cuid())
  name             String
  date             DateTime
  dateFrom         DateTime?
  dateTo           DateTime?
  regionalOfficeId String?
  valueType        String? // FIXED_PER_DAY | MULTIPLE_OF_RATE
  value            Float?
  status           String?   @default("active")
  comments         String?
  notes            String?
  appliesTo        String?   @default("WORKED_ONLY") // WORKED_ONLY | ALL_DEPLOYED_IN_OFFICE | ALL_GUARDS_IN_OFFICE
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([date])
  @@index([regionalOfficeId])
}

model Loan {
  id               String    @id @default(cuid())
  guardId          String
  guard            Guard     @relation(fields: [guardId], references: [id])
  month            DateTime
  amount           Float
  status           String    @default("PENDING") // PENDING, FINALIZED
  deploymentDays   Int?
  supervisor       String?
  manager          String?
  // Extended fields — legacy ERP parity
  regionId         String?
  supervisorUserId String?
  managerUserId    String?
  slipNumber       String?
  paymentDate      DateTime?
  paymentMethod    String? // BANK | CASH | MOBILE
  bankName         String?
  accountNumber    String?
  imageBase64      String?
  issuerId         String?
  finalizedAt      DateTime?
  finalizedById    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([guardId])
  @@index([status])
  @@index([regionId])
  @@index([month])
}

model PayrollSpecialDuty {
  id               String   @id @default(cuid())
  guardId          String
  guard            Guard    @relation(fields: [guardId], references: [id])
  dateFrom         DateTime
  dateTo           DateTime
  hours            Float
  hourRate         Float
  amount           Float
  comments         String?
  attachmentBase64 String?
  status           String   @default("ACTIVE") // ACTIVE | CANCELLED
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id])
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([guardId])
  @@index([dateFrom])
  @@index([clientId])
  @@index([branchId])
}

model PayrollLoanFinalizationHistory {
  id              String   @id @default(cuid())
  finalizedAt     DateTime @default(now())
  finalizedById   String
  finalizedByName String
  regionId        String?
  regionName      String?
  month           DateTime
  loanCount       Int
  totalAmount     Float
  loanIdsJson     String // JSON array of loan IDs included in this batch
  createdAt       DateTime @default(now())

  @@index([finalizedAt])
  @@index([month])
}

model PayrollSalarySlip {
  id             String   @id @default(cuid())
  guardId        String
  guard          Guard    @relation(fields: [guardId], references: [id])
  month          DateTime
  year           Int
  earningsJson   String // { basicSalary, workingDays, paidWorkingDays, overtime, gazettedHolidays, arrears, ... }
  deductionsJson String // { advanceSalary, eobi, mess, specialBranch, apsaaTraining, absencePenalty, ... }
  grossPay       Float
  netPayable     Float
  payslipBase64  String? // generated PDF/HTML as base64
  generatedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([guardId, month, year])
  @@index([month])
}

model PayrollDefault {
  id                       String   @id @default(cuid())
  regionalOfficeId         String?
  trainingSchoolFeeTotal   Float    @default(0)
  trainingSchoolFeeMonthly Float    @default(0)
  cwfDeduction             Float    @default(0)
  spBrVerAgeLimit          Int?
  spBrVerDays              Int?
  spBrVerAmount            Float?
  createdById              String?
  createdByName            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([regionalOfficeId])
}

// ============================================
// INVENTORY MODULE
// ============================================

model InventoryCategory {
  id        String   @id @default(cuid())
  name      String   @unique // WEAPON, UNIFORM, EQUIPMENT, AMMUNITION
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   InventoryItem[]
  demands InventoryDemand[]
}

model InventoryVendor {
  id                 String   @id @default(cuid())
  name               String   @unique
  contact            String?
  companyPhone       String?
  contactPerson      String?
  contactPersonPhone String?
  address            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items     InventoryItem[]
  purchases StoreInventoryPurchase[]
}

model InventoryItem {
  id            String    @id @default(cuid())
  uniqueNumber  String    @unique
  serialNumber  String?
  orderId       String?
  price         Float?
  purchaseDate  DateTime?
  expiryDate    DateTime?
  warrantyTime  String?
  warrantyType  String?
  size          String?
  weight        String?
  length        String?
  width         String?
  color         String?
  isInsured     Boolean   @default(false)
  isNonUnique   Boolean   @default(false)
  quantity      Int       @default(1)
  status        String    @default("AVAILABLE") // AVAILABLE, ISSUED, CONDEMNED
  licenseNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId       String
  category         InventoryCategory   @relation(fields: [categoryId], references: [id])
  conditionId      String?
  condition        InventoryCondition? @relation(fields: [conditionId], references: [id])
  vendorId         String?
  vendor           InventoryVendor?    @relation(fields: [vendorId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice?     @relation(fields: [regionalOfficeId], references: [id])

  assignments InventoryAssignment[]

  @@index([uniqueNumber])
  @@index([status])
  @@index([categoryId])
  @@index([conditionId])
}

model InventoryCondition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items InventoryItem[]
}

model InventoryAssignment {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  guardId    String?
  guard      Guard?        @relation(fields: [guardId], references: [id])
  clientId   String?
  client     Client?       @relation(fields: [clientId], references: [id])
  assignedAt DateTime      @default(now())
  returnedAt DateTime?
  notes      String?

  @@index([itemId])
  @@index([guardId])
  @@index([clientId])
}

model InventoryDemand {
  id               String             @id @default(cuid())
  categoryId       String?
  category         InventoryCategory? @relation(fields: [categoryId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice?    @relation(fields: [regionalOfficeId], references: [id])
  quantity         Int
  requiredBy       DateTime?
  reason           String?
  status           String             @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([categoryId])
  @@index([regionalOfficeId])
  @@index([status])
}

// ============================================
// STORE INVENTORY MODULE (V2)
// ============================================

model Store {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  type          String?
  prefix        String?
  isHeadOffice  Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  address       String?
  contactNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])

  balances        StoreInventoryBalance[]
  purchases       StoreInventoryPurchase[]
  adjustments     StoreInventoryAdjustment[]
  demandsFrom     StoreInventoryDemand[]         @relation("StoreInventoryDemandFromStore")
  demandsTo       StoreInventoryDemand[]         @relation("StoreInventoryDemandToStore")
  demandResponses StoreInventoryDemandResponse[]
  assignments     StoreInventoryAssignment[]
  stockMovements  StoreInventoryMovement[]

  @@index([regionalOfficeId])
  @@index([isActive])
}

model StoreInventoryBrand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreInventoryProduct[]
}

model StoreInventoryUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  shortCode String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreInventoryProduct[]
}

model StoreInventoryStatus {
  id         String                  @id @default(cuid())
  name       String                  @unique
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  categoryId String?
  category   StoreInventoryCategory? @relation(fields: [categoryId], references: [id])

  products StoreInventoryProduct[]
}

model StoreInventoryCategory {
  id                String                   @id @default(cuid())
  name              String                   @unique
  canAssignGuard    Boolean                  @default(false)
  canAssignEmployee Boolean                  @default(false)
  canAssignClient   Boolean                  @default(false)
  parentId          String?
  parent            StoreInventoryCategory?  @relation("StoreInventoryCategoryParent", fields: [parentId], references: [id])
  children          StoreInventoryCategory[] @relation("StoreInventoryCategoryParent")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  products StoreInventoryProduct[]
  statuses StoreInventoryStatus[]

  @@index([parentId])
}

model StoreInventoryConditionV2 {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products          StoreInventoryProduct[]
  assignments       StoreInventoryAssignment[]
  returnAssignments StoreInventoryAssignment[] @relation("StoreInventoryAssignmentReturnCondition")
}

model StoreInventoryWeaponType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreInventoryProduct[]
}

model StoreInventoryCalibre {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreInventoryProduct[]
}

model StoreInventoryLicenseType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreInventoryProduct[]
}

model StoreInventoryLicense {
  id             String    @id @default(cuid())
  validity       String
  licenseNumber  String    @unique
  clientId       String?
  weaponNumber   String?
  weaponTypeId   String?
  calibreId      String?
  issueDate      DateTime?
  expiryDate     DateTime?
  attachmentName String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clientId])
  @@index([weaponTypeId])
  @@index([calibreId])
  @@index([createdById])
}

model StoreInventoryVariation {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreInventoryProduct[]
}

model StoreInventoryRepairing {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreInventoryProduct[]
}

model StoreInventoryProduct {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  description    String?
  imageUrl       String?
  serialRequired Boolean  @default(false)
  minStockLevel  Int?
  maxStockLevel  Int?
  reorderLevel   Int?
  barcode        String?
  hsCode         String?
  warrantyMonths Int?
  licenseNumber  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brandId       String?
  brand         StoreInventoryBrand?       @relation(fields: [brandId], references: [id])
  unitId        String?
  unit          StoreInventoryUnit?        @relation(fields: [unitId], references: [id])
  statusId      String?
  status        StoreInventoryStatus?      @relation(fields: [statusId], references: [id])
  conditionId   String?
  condition     StoreInventoryConditionV2? @relation(fields: [conditionId], references: [id])
  weaponTypeId  String?
  weaponType    StoreInventoryWeaponType?  @relation(fields: [weaponTypeId], references: [id])
  calibreId     String?
  calibre       StoreInventoryCalibre?     @relation(fields: [calibreId], references: [id])
  licenseTypeId String?
  licenseType   StoreInventoryLicenseType? @relation(fields: [licenseTypeId], references: [id])
  variationId   String?
  variation     StoreInventoryVariation?   @relation(fields: [variationId], references: [id])
  repairingId   String?
  repairing     StoreInventoryRepairing?   @relation(fields: [repairingId], references: [id])
  categoryId    String?
  category      StoreInventoryCategory?    @relation(fields: [categoryId], references: [id])

  balances            StoreInventoryBalance[]
  purchaseLines       StoreInventoryPurchaseLine[]
  adjustmentLines     StoreInventoryAdjustmentLine[]
  demandLines         StoreInventoryDemandLine[]
  demandResponseLines StoreInventoryDemandResponseLine[]
  assignments         StoreInventoryAssignment[]
  stockMovements      StoreInventoryMovement[]

  @@index([name])
  @@index([brandId])
  @@index([unitId])
  @@index([statusId])
  @@index([conditionId])
  @@index([categoryId])
}

model StoreInventoryBalance {
  id             String   @id @default(cuid())
  quantityOnHand Int      @default(0)
  quantityHeld   Int      @default(0)
  quantityIssued Int      @default(0)
  avgUnitCost    Float?
  updatedAt      DateTime @updatedAt

  storeId   String
  store     Store                 @relation(fields: [storeId], references: [id])
  productId String
  product   StoreInventoryProduct @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@index([productId])
}

model StoreInventoryPurchase {
  id            String                       @id @default(cuid())
  referenceNo   String?                      @unique
  invoiceNo     String?
  attachmentUrl String?
  supplierName  String?
  vendorId      String?
  vendor        InventoryVendor?             @relation(fields: [vendorId], references: [id])
  status        StoreInventoryPurchaseStatus @default(DRAFT)
  purchasedAt   DateTime                     @default(now())
  receivedAt    DateTime?
  notes         String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  storeId      String
  store        Store   @relation(fields: [storeId], references: [id])
  createdById  String
  createdBy    User    @relation("StoreInventoryPurchaseCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?   @relation("StoreInventoryPurchaseApprovedBy", fields: [approvedById], references: [id])

  lines StoreInventoryPurchaseLine[]

  @@index([storeId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

model StoreInventoryPurchaseLine {
  id        String   @id @default(cuid())
  quantity  Int
  unitCost  Float?
  totalCost Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseId String
  purchase   StoreInventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    StoreInventoryProduct  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model StoreInventoryAdjustment {
  id             String                       @id @default(cuid())
  adjustmentType StoreInventoryAdjustmentType
  reason         String?
  notes          String?
  adjustedAt     DateTime                     @default(now())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  storeId     String
  store       Store  @relation(fields: [storeId], references: [id])
  createdById String
  createdBy   User   @relation("StoreInventoryAdjustmentCreatedBy", fields: [createdById], references: [id])

  lines StoreInventoryAdjustmentLine[]

  @@index([storeId])
  @@index([createdById])
  @@index([adjustmentType])
}

model StoreInventoryAdjustmentLine {
  id             String   @id @default(cuid())
  quantityBefore Int
  quantityDelta  Int
  quantityAfter  Int
  unitCost       Float?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adjustmentId String
  adjustment   StoreInventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      StoreInventoryProduct    @relation(fields: [productId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
}

model StoreInventoryDemand {
  id          String                     @id @default(cuid())
  requestNo   String?                    @unique
  status      StoreInventoryDemandStatus @default(DRAFT)
  requiredBy  DateTime?
  requestedAt DateTime                   @default(now())
  approvedAt  DateTime?
  fulfilledAt DateTime?
  reason      String?
  notes       String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  fromStoreId   String?
  fromStore     Store?  @relation("StoreInventoryDemandFromStore", fields: [fromStoreId], references: [id])
  toStoreId     String?
  toStore       Store?  @relation("StoreInventoryDemandToStore", fields: [toStoreId], references: [id])
  requestedById String
  requestedBy   User    @relation("StoreInventoryDemandRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("StoreInventoryDemandApprovedBy", fields: [approvedById], references: [id])

  lines     StoreInventoryDemandLine[]
  responses StoreInventoryDemandResponse[]

  @@index([status])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@index([requestedById])
  @@index([approvedById])
}

model StoreInventoryDemandLine {
  id           String   @id @default(cuid())
  requestedQty Int
  approvedQty  Int?
  fulfilledQty Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  demandId  String
  demand    StoreInventoryDemand  @relation(fields: [demandId], references: [id], onDelete: Cascade)
  productId String
  product   StoreInventoryProduct @relation(fields: [productId], references: [id])

  responseLines StoreInventoryDemandResponseLine[]

  @@index([demandId])
  @@index([productId])
}

model StoreInventoryDemandResponse {
  id          String                             @id @default(cuid())
  status      StoreInventoryDemandResponseStatus @default(PENDING)
  respondedAt DateTime                           @default(now())
  notes       String?
  createdAt   DateTime                           @default(now())
  updatedAt   DateTime                           @updatedAt

  demandId         String
  demand           StoreInventoryDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  responderStoreId String
  responderStore   Store                @relation(fields: [responderStoreId], references: [id])
  responderId      String
  responder        User                 @relation("StoreInventoryDemandResponseResponder", fields: [responderId], references: [id])

  lines StoreInventoryDemandResponseLine[]

  @@index([demandId])
  @@index([responderStoreId])
  @@index([responderId])
  @@index([status])
}

model StoreInventoryDemandResponseLine {
  id        String   @id @default(cuid())
  quantity  Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responseId   String
  response     StoreInventoryDemandResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  demandLineId String
  demandLine   StoreInventoryDemandLine     @relation(fields: [demandLineId], references: [id])
  productId    String
  product      StoreInventoryProduct        @relation(fields: [productId], references: [id])

  @@index([responseId])
  @@index([demandLineId])
  @@index([productId])
}

model StoreInventoryAssignment {
  id               String                             @id @default(cuid())
  quantity         Int                                @default(1)
  status           StoreInventoryAssignmentStatus     @default(ASSIGNED)
  assignedToType   StoreInventoryAssignmentTargetType @default(EMPLOYEE)
  assignedAt       DateTime                           @default(now())
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  notes            String?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  storeId            String
  store              Store                      @relation(fields: [storeId], references: [id])
  productId          String
  product            StoreInventoryProduct      @relation(fields: [productId], references: [id])
  conditionId        String?
  condition          StoreInventoryConditionV2? @relation(fields: [conditionId], references: [id])
  assignedToUserId   String?
  assignedToUser     User?                      @relation("StoreInventoryAssignmentAssignee", fields: [assignedToUserId], references: [id])
  assignedToGuardId  String?
  assignedToGuard    Guard?                     @relation("StoreInventoryAssignmentGuardAssignee", fields: [assignedToGuardId], references: [id])
  assignedToClientId String?
  assignedToClient   Client?                    @relation("StoreInventoryAssignmentClientAssignee", fields: [assignedToClientId], references: [id])
  assignedByUserId   String
  assignedByUser     User                       @relation("StoreInventoryAssignmentIssuer", fields: [assignedByUserId], references: [id])
  returnedByUserId   String?
  returnedByUser     User?                      @relation("StoreInventoryAssignmentReturner", fields: [returnedByUserId], references: [id])
  returnConditionId  String?
  returnCondition    StoreInventoryConditionV2? @relation("StoreInventoryAssignmentReturnCondition", fields: [returnConditionId], references: [id])

  @@index([storeId])
  @@index([productId])
  @@index([conditionId])
  @@index([assignedToUserId])
  @@index([assignedToGuardId])
  @@index([assignedToClientId])
  @@index([assignedToType])
  @@index([assignedByUserId])
  @@index([returnedByUserId])
  @@index([status])
}

model StoreInventoryMovement {
  id            String                     @id @default(cuid())
  movementType  StoreInventoryMovementType
  quantity      Int
  occurredAt    DateTime                   @default(now())
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime                   @default(now())

  storeId       String
  store         Store                 @relation(fields: [storeId], references: [id])
  productId     String
  product       StoreInventoryProduct @relation(fields: [productId], references: [id])
  performedById String?
  performedBy   User?                 @relation("StoreInventoryMovementPerformedBy", fields: [performedById], references: [id])

  @@index([storeId, productId])
  @@index([movementType])
  @@index([occurredAt])
  @@index([performedById])
}

// ============================================
// TICKETING MODULE
// ============================================

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber Int            @default(autoincrement())
  subject      String
  description  String?
  senderId     String
  sender       User           @relation("TicketSender", fields: [senderId], references: [id])
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  categoryId   String
  category     TicketCategory @relation(fields: [categoryId], references: [id])
  priorityId   String
  priority     TicketPriority @relation(fields: [priorityId], references: [id])
  statusId     String
  status       TicketStatus   @relation(fields: [statusId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments TicketComment[]

  @@index([senderId])
  @@index([assignedToId])
  @@index([statusId])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ticketId])
  @@index([userId])
}

model TicketCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
}

model TicketPriority {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model TicketStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

// ============================================
// AUDIT MODULE
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  event       String // CREATED, UPDATED, DELETED, etc.
  module      String // GUARDS, PAYROLL, etc.
  ipAddress   String?
  description String?
  createdAt   DateTime @default(now())

  // Target-entity enrichment — for insights engine (scope-violation detection, etc.)
  // All optional so existing writers remain compatible.
  targetEntityType       String? // "Guard" | "Client" | "Invoice" | ...
  targetEntityId         String?
  targetRegionId         String?
  targetRegionalOfficeId String?

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@index([targetEntityType, targetEntityId])
  @@index([targetRegionId])
  @@index([targetRegionalOfficeId])
}

model InsightConfig {
  id               String    @id @default(cuid())
  key              String    @unique
  thresholds       Json      @default("{}")
  muted            Boolean   @default(false)
  mutedUntil       DateTime?
  mutedReason      String?
  mutedById        String?
  severityOverride String? // HIGH | MEDIUM | LOW — nullable means use default
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  updatedById      String?

  @@index([muted])
}

// ============================================
// USERS RELATIONSHIPS MODULE
// ============================================

model ManagerSupervisorAssignment {
  id               String          @id @default(cuid())
  managerId        String
  manager          User            @relation("ManagerAssignments", fields: [managerId], references: [id])
  supervisorId     String
  supervisor       User            @relation("SupervisorAssignments", fields: [supervisorId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])
  status           String          @default("ACTIVE")
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([managerId, supervisorId])
  @@index([managerId])
  @@index([supervisorId])
  @@index([regionalOfficeId])
}

model ClientSupervisorAssignment {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supervisorId  String
  supervisor    User     @relation(fields: [supervisorId], references: [id])
  effectiveDate DateTime @default(now())
  status        String   @default("ACTIVE")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([branchId])
  @@index([supervisorId])
}

model GuardSupervisorAssignment {
  id           String    @id @default(cuid())
  guardId      String
  guard        Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   User      @relation(fields: [supervisorId], references: [id])
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([guardId])
  @@index([supervisorId])
  @@index([status])
}

model Requisition {
  id            String    @id @default(cuid())
  title         String
  description   String?
  module        String
  priority      String    @default("NORMAL")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requesterId   String
  requester     User      @relation("RequisitionRequester", fields: [requesterId], references: [id])
  approverId    String?
  approver      User?     @relation("RequisitionApprover", fields: [approverId], references: [id])
  approvedAt    DateTime?
  decisionNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([module])
  @@index([requesterId])
  @@index([approverId])
}

// ============================================
// SETTINGS MASTER DATA
// ============================================

model GuardBankName {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardPledgeableDocument {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuardPledgedDocumentRecord {
  id                 String                        @id @default(cuid())
  guardId            String
  guard              Guard                         @relation(fields: [guardId], references: [id], onDelete: Cascade)
  documentTypeName   String
  receivedBy         String?
  receivedAt         DateTime                      @default(now())
  returnedBy         String?
  returnedAt         DateTime?
  status             String                        @default("HELD") // HELD | RETURNED
  // Return details
  returnType         String? // CLEARANCE | TEMPORARY
  returnConditionId  String?
  returnCondition    PledgeDocReturnCondition?     @relation(fields: [returnConditionId], references: [id])
  returnReason       String?
  expectedReturnDate DateTime?
  attachmentData     String?
  attachmentName     String?
  notes              String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  history            GuardPledgedDocumentHistory[]

  @@index([guardId])
  @@index([returnConditionId])
}

model PledgeDocReturnCondition {
  id          String                       @id @default(cuid())
  name        String                       @unique
  description String?
  isActive    Boolean                      @default(true)
  sortOrder   Int                          @default(0)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  records     GuardPledgedDocumentRecord[]
}

model GuardPledgedDocumentHistory {
  id             String                     @id @default(cuid())
  recordId       String
  record         GuardPledgedDocumentRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  guardId        String
  action         String // CREATED | RETURNED | REHOLD | VERSION_UPLOADED | UPDATED | DELETED
  performedBy    String?
  performedAt    DateTime                   @default(now())
  details        String? // JSON string with snapshot
  attachmentData String? // archived file data (for version history)
  attachmentName String? // archived file name

  @@index([recordId])
  @@index([guardId])
}

model GuardExServiceType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardDesignationType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardWalletType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

