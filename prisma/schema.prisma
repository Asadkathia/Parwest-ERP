  guardId     String
  guard       Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  courseName  String
  courseLevel String
  instructor  String
  location    String
  issueDate   DateTime?
  description String?
  fileName    String? // uploaded file name
