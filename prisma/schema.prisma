// ============================================
// PAYROLL REWORK (Apr 2026)
// ============================================

model PayrollDeductionType {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "EOBI", "CWF", "TRAINING_FEE"
  name          String // display name
  description   String?
  defaultAmount Float    @default(0) // default amount when auto-applied
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries PayrollDeductionEntry[]

  @@index([isActive])
}

model PayrollDeductionEntry {
  id              String               @id @default(cuid())
  payrollId       String
  payroll         Payroll              @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  deductionTypeId String
  deductionType   PayrollDeductionType @relation(fields: [deductionTypeId], references: [id])
  amount          Float
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([payrollId, deductionTypeId])
  @@index([payrollId])
}

model PayrollReserveLedger {
  id            String    @id @default(cuid())
  guardId       String
  guard         Guard     @relation(fields: [guardId], references: [id])
  payrollId     String?
  payroll       Payroll?  @relation(fields: [payrollId], references: [id])
  type          String // ACCRUED | RELEASED
  amount        Float
  reason        String?
  byUserId      String?
  byUserName    String?
  paymentMethod String? // for RELEASED entries
  slipNumber    String? // for RELEASED entries
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([guardId])
  @@index([type])
  @@index([payrollId])
}

model PayrollSalaryFinalizationHistory {
  id                String   @id @default(cuid())
  finalizedAt       DateTime @default(now())
  finalizedByUserId String
  finalizedByName   String
  scope             String // REGION | GLOBAL
  regionId          String?
  regionalOfficeId  String?
  month             DateTime
  payrollCount      Int
  totalNetPayable   Float
  totalReserve      Float
  payrollIdsJson    String // JSON array of payroll row IDs in this batch
  createdAt         DateTime @default(now())

  @@index([finalizedAt])
  @@index([month])
  @@index([scope])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind        String // GUARD_SALARY | SPECIAL_DUTY | MANUAL
  refId       String? // GUARD_SALARY: payrollId OR deploymentId; SPECIAL_DUTY: specialDutyId; nullable for MANUAL
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  lineTotal   Float
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}
