// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTHENTICATION & AUTHORIZATION
// ============================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  contactNumber String?
  photoUrl      String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  roleId           String
  role             Role            @relation(fields: [roleId], references: [id])
  regionId         String?
  region           Region?         @relation(fields: [regionId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])

  permissions           UserPermission[]
  statusHistory         UserStatusHistory[]
  auditLogs             AuditLog[]
  ticketsCreated        Ticket[]                      @relation("TicketSender")
  ticketsAssigned       Ticket[]                      @relation("TicketAssignee")
  managerAssignments    ManagerSupervisorAssignment[] @relation("ManagerAssignments")
  supervisorAssignments ManagerSupervisorAssignment[] @relation("SupervisorAssignments")
  clientAssignments     ClientSupervisorAssignment[]
  guardAssignments      GuardSupervisorAssignment[]
  requisitionsRequested Requisition[]                 @relation("RequisitionRequester")
  requisitionsApproved  Requisition[]                 @relation("RequisitionApprover")

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model UserPermission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module         String // GUARDS, PAYROLL, CLIENTS, etc.
  canCreate      Boolean  @default(false)
  canView        Boolean  @default(false)
  canUpdate      Boolean  @default(false)
  canDelete      Boolean  @default(false)
  canRequisition Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

model UserStatusHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  reason    String?
  changedAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// ORGANIZATIONAL STRUCTURE
// ============================================

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regionalOffices RegionalOffice[]
  users           User[]
  guards          Guard[]
  clients         Client[]
  deploymentRates DeploymentRate[]
}

model RegionalOffice {
  id         String   @id @default(cuid())
  name       String
  seriesCode String   @unique // e.g., 'L' for Lahore
  officeHead String?
  phone      String?
  mobile     String?
  fax        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  users                        User[]
  guards                       Guard[]
  deployments                  Deployment[]
  inventory                    InventoryItem[]
  inventoryDemands             InventoryDemand[]
  managerSupervisorAssignments ManagerSupervisorAssignment[]

  @@index([regionId])
}

// ============================================
// GUARDS MODULE
// ============================================

model Guard {
  id                String    @id @default(cuid())
  parwestId         String    @unique
  name              String
  cnic              String    @unique
  phone             String?
  email             String?
  dateOfBirth       DateTime?
  age               Int?
  fatherName        String?
  religion          String?
  maritalStatus     String?
  education         String?
  addressPermanent  String?
  addressCurrent    String?
  emergencyContact  String?
  status            String    @default("PENDING") // PENDING, ACTIVE, INACTIVE, TERMINATED, BLACKLISTED
  isExService       Boolean   @default(false)
  exServiceRank     String?
  exServiceRegiment String?
  bankName          String?
  bankAccountNumber String?
  bankAccountType   String?
  bankIban          String?
  bankBranchCode    String?
  bankAccountsJson  String?   // JSON array of GuardBankAccount objects
  joiningDate       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])
  regionId         String?
  region           Region?         @relation(fields: [regionId], references: [id])

  prerequisites         GuardPrerequisite[]
  deployments           Deployment[]
  payrolls              Payroll[]
  loans                 Loan[]
  attendances           Attendance[]
  inventoryAssignments  InventoryAssignment[]
  residenceAssignment   ResidenceAssignment?
  trainings             Training[]
  supervisorAssignments GuardSupervisorAssignment[]

  @@index([parwestId])
  @@index([cnic])
  @@index([status])
}

model BlacklistedCnic {
  id              String   @id @default(cuid())
  cnic            String   @unique
  reason          String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cnic])
}

model DeploymentRate {
  id            String   @id @default(cuid())
  regionId      String?
  region        Region?  @relation(fields: [regionId], references: [id])
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  deployAs      String?
  guardType     String?
  shiftType     String? // DAY, NIGHT, BOTH
  salary        Float?
  overtime      Float?
  extraHours    Float?
  postAllowance Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([regionId])
  @@index([clientId])
  @@index([branchId])
}

model GuardPrerequisite {
  id          String    @id @default(cuid())
  guardId     String
  guard       Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  type        String // NADRA, HEALTH, POLICE, EYESIGHT, CHARACTER, MENTAL_HEALTH, GUARANTOR, COMPANY_CARD
  status      String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  documentUrl String?
  verifiedAt  DateTime?
  verifiedBy  String?
  expiryDate  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([guardId])
  @@index([type])
}

model Deployment {
  id               String         @id @default(cuid())
  guardId          String
  guard            Guard          @relation(fields: [guardId], references: [id])
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id])
  regionalOfficeId String
  regionalOffice   RegionalOffice @relation(fields: [regionalOfficeId], references: [id])
  designation      String
  deploymentDate   DateTime
  shiftType        String // DAY, NIGHT, BOTH
  rate             Float?
  status           String         @default("ACTIVE") // ACTIVE, INACTIVE
  notes            String?

  // Extended fields from documentation
  guardType       String? // Security Guard, Supervisor, etc.
  salary          Float?
  overtime        Float?
  extraHours      Float?
  postAllowance   Float?
  dayShiftStart   String? // Time format: HH:MM
  dayShiftEnd     String?
  nightShiftStart String?
  nightShiftEnd   String?
  deploymentType  String? @default("REGULAR") // REGULAR, OVERTIME
  isExtraGuard    Boolean @default(false)
  comment         String?

  // End deployment tracking
  endDate   DateTime?
  endReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardId])
  @@index([clientId])
  @@index([status])
}

model Attendance {
  id        String   @id @default(cuid())
  guardId   String
  guard     Guard    @relation(fields: [guardId], references: [id])
  date      DateTime
  status    String // PRESENT, ABSENT, LEAVE
  shiftType String? // DAY, NIGHT
  notes     String?
  createdAt DateTime @default(now())

  @@unique([guardId, date])
  @@index([guardId])
  @@index([date])
}

model ResidenceAssignment {
  id          String     @id @default(cuid())
  guardId     String     @unique
  guard       Guard      @relation(fields: [guardId], references: [id])
  residenceId String?
  residence   Residence? @relation(fields: [residenceId], references: [id])
  location    String
  assignedAt  DateTime   @default(now())
  notes       String?

  @@index([residenceId])
}

model Residence {
  id                 String   @id @default(cuid())
  address            String
  ownerName          String?
  ownerPhone         String?
  supervisor         String?
  capacity           Int?
  occupied           Int?
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE
  rentPayable        Float?
  utilityBills       String?  // INCLUDED, EXCLUDED, SHARED
  paymentMethod      String?  // CASH, BANK_TRANSFER
  referredBy         String?
  state              String?
  city               String?
  remarks            String?
  contractAttachment String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignments ResidenceAssignment[]

  @@index([status])
}

model Training {
  id           String   @id @default(cuid())
  guardId      String
  guard        Guard    @relation(fields: [guardId], references: [id])
  trainingType String
  completedAt  DateTime
  instructor   String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([guardId])
}

// ============================================
// CLIENTS MODULE
// ============================================

model Client {
  id                String   @id @default(cuid())
  name              String
  email             String?
  type              String // BANK, MANUFACTURER, etc.
  enrollmentDate    DateTime @default(now())
  isBranchless      Boolean  @default(false)
  headOfficeAddress String?
  city              String?
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED
  logoUrl           String?
  ntn               String? // National Tax Number
  strn              String? // Sales Tax Registration
  contractUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  branches              Branch[]
  deployments           Deployment[]
  pricingConfigs        PricingConfig[]
  inventoryAssignments  InventoryAssignment[]
  invoices              Invoice[]
  deploymentRates       DeploymentRate[]
  supervisorAssignments ClientSupervisorAssignment[]

  @@index([name])
  @@index([status])
}

model Branch {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  address       String?
  city          String?
  province      String?
  isHeadOffice  Boolean  @default(false)
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deployments           Deployment[]
  deploymentRates       DeploymentRate[]
  supervisorAssignments ClientSupervisorAssignment[]

  @@index([clientId])
}

model PricingConfig {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  guardType String
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Invoice {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  invoiceNumber String    @unique
  month         DateTime
  amount        Float
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}

// ============================================
// PAYROLL MODULE
// ============================================

model Payroll {
  id                 String   @id @default(cuid())
  guardId            String
  guard              Guard    @relation(fields: [guardId], references: [id])
  month              DateTime
  year               Int
  deploymentDays     Int      @default(0)
  baseSalary         Float    @default(0)
  extraHours         Float    @default(0)
  extraHoursAmount   Float    @default(0)
  specialDutyHours   Float    @default(0)
  specialDutyAmount  Float    @default(0)
  loans              Float    @default(0)
  otherDeductions    Float    @default(0)
  trainingSchoolFees Float    @default(0)
  cwf                Float    @default(0) // Contribution Welfare Fund
  eobi               Float    @default(0)
  essi               Float    @default(0)
  netSalary          Float    @default(0)
  paymentStatus      String   @default("PENDING") // PENDING, PAID, UNPAID
  paymentMethod      String? // BANK, CASH, MOBILE
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([guardId, month, year])
  @@index([guardId])
  @@index([month])
  @@index([paymentStatus])
}

model PayrollHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Loan {
  id             String   @id @default(cuid())
  guardId        String
  guard          Guard    @relation(fields: [guardId], references: [id])
  month          DateTime
  amount         Float
  status         String   @default("PENDING") // PENDING, FINALIZED
  deploymentDays Int?
  supervisor     String?
  manager        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([guardId])
  @@index([status])
}

// ============================================
// INVENTORY MODULE
// ============================================

model InventoryCategory {
  id        String   @id @default(cuid())
  name      String   @unique // WEAPON, UNIFORM, EQUIPMENT, AMMUNITION
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   InventoryItem[]
  demands InventoryDemand[]
}

model InventoryVendor {
  id        String   @id @default(cuid())
  name      String   @unique
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]
}

model InventoryItem {
  id            String    @id @default(cuid())
  uniqueNumber  String    @unique
  serialNumber  String?
  orderId       String?
  price         Float?
  purchaseDate  DateTime?
  expiryDate    DateTime?
  warrantyTime  String?
  warrantyType  String?
  size          String?
  weight        String?
  length        String?
  width         String?
  color         String?
  isInsured     Boolean   @default(false)
  isNonUnique   Boolean   @default(false)
  quantity      Int       @default(1)
  status        String    @default("AVAILABLE") // AVAILABLE, ISSUED, CONDEMNED
  licenseNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId       String
  category         InventoryCategory   @relation(fields: [categoryId], references: [id])
  conditionId      String?
  condition        InventoryCondition? @relation(fields: [conditionId], references: [id])
  vendorId         String?
  vendor           InventoryVendor?    @relation(fields: [vendorId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice?     @relation(fields: [regionalOfficeId], references: [id])

  assignments InventoryAssignment[]

  @@index([uniqueNumber])
  @@index([status])
  @@index([categoryId])
  @@index([conditionId])
}

model InventoryCondition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items InventoryItem[]
}

model InventoryAssignment {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  guardId    String?
  guard      Guard?        @relation(fields: [guardId], references: [id])
  clientId   String?
  client     Client?       @relation(fields: [clientId], references: [id])
  assignedAt DateTime      @default(now())
  returnedAt DateTime?
  notes      String?

  @@index([itemId])
  @@index([guardId])
  @@index([clientId])
}

model InventoryDemand {
  id               String             @id @default(cuid())
  categoryId       String?
  category         InventoryCategory? @relation(fields: [categoryId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice?    @relation(fields: [regionalOfficeId], references: [id])
  quantity         Int
  requiredBy       DateTime?
  reason           String?
  status           String             @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([categoryId])
  @@index([regionalOfficeId])
  @@index([status])
}

// ============================================
// TICKETING MODULE
// ============================================

model Ticket {
  id           String         @id @default(cuid())
  subject      String
  description  String?
  senderId     String
  sender       User           @relation("TicketSender", fields: [senderId], references: [id])
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  categoryId   String
  category     TicketCategory @relation(fields: [categoryId], references: [id])
  priorityId   String
  priority     TicketPriority @relation(fields: [priorityId], references: [id])
  statusId     String
  status       TicketStatus   @relation(fields: [statusId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([senderId])
  @@index([assignedToId])
  @@index([statusId])
}

model TicketCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
}

model TicketPriority {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

model TicketStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

// ============================================
// AUDIT MODULE
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  event       String // CREATED, UPDATED, DELETED, etc.
  module      String // GUARDS, PAYROLL, etc.
  ipAddress   String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// ============================================
// USERS RELATIONSHIPS MODULE
// ============================================

model ManagerSupervisorAssignment {
  id               String          @id @default(cuid())
  managerId        String
  manager          User            @relation("ManagerAssignments", fields: [managerId], references: [id])
  supervisorId     String
  supervisor       User            @relation("SupervisorAssignments", fields: [supervisorId], references: [id])
  regionalOfficeId String?
  regionalOffice   RegionalOffice? @relation(fields: [regionalOfficeId], references: [id])
  effectiveDate    DateTime        @default(now())
  status           String          @default("ACTIVE")
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([managerId])
  @@index([supervisorId])
  @@index([regionalOfficeId])
}

model ClientSupervisorAssignment {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supervisorId  String
  supervisor    User     @relation(fields: [supervisorId], references: [id])
  effectiveDate DateTime @default(now())
  status        String   @default("ACTIVE")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([branchId])
  @@index([supervisorId])
}

model GuardSupervisorAssignment {
  id           String    @id @default(cuid())
  guardId      String
  guard        Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   User      @relation(fields: [supervisorId], references: [id])
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([guardId])
  @@index([supervisorId])
  @@index([status])
}

model Requisition {
  id            String    @id @default(cuid())
  title         String
  description   String?
  module        String
  priority      String    @default("NORMAL")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requesterId   String
  requester     User      @relation("RequisitionRequester", fields: [requesterId], references: [id])
  approverId    String?
  approver      User?     @relation("RequisitionApprover", fields: [approverId], references: [id])
  approvedAt    DateTime?
  decisionNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([module])
  @@index([requesterId])
  @@index([approverId])
}

// ============================================
// SETTINGS MASTER DATA
// ============================================

model GuardBankName {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardPledgeableDocument {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
